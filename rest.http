### ============================================
### AWS Generic APIs - Textract
### ============================================

### Analyze Document (Table + Form Extraction)
POST {{baseUrl}}/api/aws/textract/analyze-document
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}",
  "featureTypes": ["TABLES", "FORMS"]
}

###

### Detect Text (Simple Text Extraction)
POST {{baseUrl}}/api/aws/textract/detect-text
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}"
}

###

### Validate Image Quality
POST {{baseUrl}}/api/aws/textract/validate-image
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}"
}

###

### ============================================
### AWS Generic APIs - Bedrock (LLM)
### ============================================

### Invoke Model (Generic LLM with Custom Parameters)
POST {{baseUrl}}/api/aws/bedrock/invoke-model
Content-Type: application/json

{
  "userPrompt": "Explain hemoglobin levels in simple terms",
  "systemPrompt": "You are a medical AI assistant providing patient-friendly explanations",
  "modelId": "us.anthropic.claude-3-5-sonnet-20241022-v2:0",
  "maxTokens": 2000,
  "temperature": 0.7
}

###

### Invoke Claude (Convenience Method)
POST {{baseUrl}}/api/aws/bedrock/invoke-claude
Content-Type: application/json

{
  "userPrompt": "What does elevated creatinine mean?",
  "systemPrompt": "Explain in patient-friendly language"
}

###

### ============================================
### AWS Bedrock Health API - Clinical Insights
### ============================================

### Generate Clinical Insights (Abnormal Kidney Function)
POST {{baseUrl}}/api/aws/bedrock/health/clinical-insights
Content-Type: application/json

{
  "medicalData": {
    "creatinine": {
      "value": 135.0,
      "unit": "µmol/L",
      "status": "ABNORMAL"
    },
    "ammonia": {
      "value": 244.0,
      "unit": "µg/dL",
      "status": "CRITICAL"
    }
  },
  "patientContext": {
    "age": 45,
    "gender": "MALE",
    "medicalHistory": ["Diabetes Type 2"],
    "currentMedications": ["Metformin 1000mg"],
    "vitalSigns": {
      "bloodPressure": "140/90"
    },
    "additionalInfo": {}
  },
  "options": {
    "targetAudience": "PATIENT",
    "includeRiskAssessment": true,
    "includeActionPlan": true,
    "includeTrendAnalysis": false
  }
}

###

### Generate Summary (Patient-Friendly)
POST {{baseUrl}}/api/aws/bedrock/health/summary
Content-Type: application/json

{
  "medicalData": {
    "glucose": {
      "value": 7.2,
      "unit": "mmol/L",
      "status": "ELEVATED"
    }
  },
  "patientContext": {
    "age": 50,
    "gender": "FEMALE",
    "medicalHistory": [],
    "currentMedications": [],
    "vitalSigns": {},
    "additionalInfo": {}
  },
  "options": {
    "audience": "PATIENT",
    "length": "BRIEF",
    "format": "NARRATIVE"
  }
}

###

### Assess Risk (Cardiovascular Risk Assessment)
POST {{baseUrl}}/api/aws/bedrock/health/risk-assessment
Content-Type: application/json

{
  "medicalData": {
    "cholesterol": {
      "value": 6.5,
      "unit": "mmol/L"
    },
    "bloodPressure": {
      "systolic": 145,
      "diastolic": 95
    },
    "glucose": {
      "value": 6.8,
      "unit": "mmol/L"
    }
  },
  "patientContext": {
    "age": 55,
    "gender": "MALE",
    "medicalHistory": ["Hypertension", "Prediabetes"],
    "currentMedications": ["Lisinopril 10mg"],
    "vitalSigns": {
      "weight": "92kg",
      "height": "175cm"
    },
    "additionalInfo": {
      "smokingStatus": "former",
      "exerciseFrequency": "sedentary"
    }
  },
  "options": {
    "focusAreas": ["CARDIOVASCULAR", "METABOLIC"],
    "includePreventionStrategies": true,
    "timeHorizon": 12
  }
}

###

### Generate Recommendations
POST {{baseUrl}}/api/aws/bedrock/health/recommendations
Content-Type: application/json

{
  "medicalFindings": {
    "finding_1": {
      "description": "Elevated creatinine",
      "severity": "MODERATE"
    },
    "finding_2": {
      "description": "High blood ammonia",
      "severity": "HIGH"
    }
  },
  "patientContext": {
    "age": 45,
    "gender": "MALE",
    "medicalHistory": ["Diabetes Type 2"],
    "currentMedications": ["Metformin"],
    "vitalSigns": {},
    "additionalInfo": {}
  },
  "options": {
    "includeLifestyle": true,
    "includeMedication": true,
    "includeFollowUp": true,
    "evidenceBasedOnly": true
  }
}

###

### Analyze Trends (Creatinine Over Time)
POST {{baseUrl}}/api/aws/bedrock/health/trend-analysis
Content-Type: application/json

{
  "timeSeriesData": [
    {
      "timestamp": "2024-01-01T00:00:00Z",
      "testName": "creatinine",
      "value": 100.0,
      "unit": "µmol/L",
      "metadata": {}
    },
    {
      "timestamp": "2024-02-01T00:00:00Z",
      "testName": "creatinine",
      "value": 110.0,
      "unit": "µmol/L",
      "metadata": {}
    },
    {
      "timestamp": "2024-03-01T00:00:00Z",
      "testName": "creatinine",
      "value": 135.0,
      "unit": "µmol/L",
      "metadata": {}
    }
  ],
  "patientContext": {
    "age": 45,
    "gender": "MALE",
    "medicalHistory": [],
    "currentMedications": [],
    "vitalSigns": {},
    "additionalInfo": {}
  },
  "options": {
    "includeAnomalyDetection": true,
    "includePredictions": true,
    "includeSeasonalAnalysis": false
  }
}

###

### Generate Educational Content
POST {{baseUrl}}/api/aws/bedrock/health/educational-content
Content-Type: application/json

{
  "topic": "high creatinine levels",
  "patientContext": {
    "age": 45,
    "gender": "MALE",
    "medicalHistory": [],
    "currentMedications": [],
    "vitalSigns": {},
    "additionalInfo": {}
  },
  "options": {
    "readingLevel": "SIMPLE",
    "format": "FAQ",
    "maxWords": 500,
    "includeActionItems": true
  }
}

###

### ============================================
### AWS Comprehend Medical API
### ============================================

### Detect Entities (Medical NLP)
POST {{baseUrl}}/api/aws/comprehend-medical/detect-entities
Content-Type: application/json

{
  "text": "Patient has elevated serum creatinine (135 µmol/L) and high blood ammonia (244 µg/dL). Started on lactulose 30ml twice daily and rifaximin 550mg.",
  "detectPhi": false
}

###

### Infer ICD-10 Codes (Diagnosis Codes)
POST {{baseUrl}}/api/aws/comprehend-medical/infer-icd10
Content-Type: application/json

{
  "text": "Acute kidney injury with elevated creatinine and hepatic encephalopathy"
}

###

### Infer RxNorm Codes (Medication Codes)
POST {{baseUrl}}/api/aws/comprehend-medical/infer-rxnorm
Content-Type: application/json

{
  "text": "lactulose 30ml twice daily, rifaximin 550mg, metformin 1000mg"
}

###############################################################################
# MASTER ORCHESTRATION API - Complete End-to-End Processing
# Phase 2 Implementation - All 10 Stages in One Call
###############################################################################

### Master Orchestration - Process Complete Medical Report
# POST /api/v1/medical-report/process
# Orchestrates: Validation → OCR → Entity Detection → Medical Codes → Clinical Insights
# Returns: Complete analysis with all stages
POST {{baseUrl}}/api/v1/medical-report/process
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}",
  "patientContext": {
    "patientId": "P12345",
    "age": 59,
    "gender": "MALE",
    "medicalHistory": [
      "Diabetes Type 2",
      "Hypertension"
    ],
    "currentMedications": [
      "Metformin 1000mg twice daily",
      "Lisinopril 10mg once daily"
    ],
    "allergies": [
      "Penicillin"
    ],
    "vitalSigns": {
      "bloodPressure": "140/90",
      "heartRate": 78,
      "weight": "85kg",
      "height": "175cm"
    },
    "lifestyle": {
      "smokingStatus": "never",
      "alcoholUse": "occasional",
      "exerciseFrequency": "moderate"
    }
  },
  "workflowOptions": {
    "skipValidation": false,
    "includeRawText": true,
    "includeEntityRelationships": true,
    "requestedCodeSystems": ["ICD10", "RXNORM"],
    "includeEducationalContent": true,
    "riskAssessmentCategories": [
      "CARDIOVASCULAR",
      "METABOLIC",
      "RENAL",
      "HEPATIC"
    ],
    "targetAudience": "PATIENT",
    "language": "en",
    "confidenceThreshold": 0.70,
    "includeActionPlan": true,
    "includeTrendAnalysis": false
  }
}

###

### Master Orchestration - Minimal Request (All Defaults)
# Minimal required fields - uses all default workflow options
POST {{baseUrl}}/api/v1/medical-report/process
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}",
  "patientContext": {
    "patientId": "P67890",
    "age": 45,
    "gender": "FEMALE"
  }
}

###

### Master Orchestration - Skip Validation (Fast Mode)
# Use when image quality is already verified
POST {{baseUrl}}/api/v1/medical-report/process
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}",
  "patientContext": {
    "patientId": "P11111",
    "age": 35,
    "gender": "MALE"
  },
  "workflowOptions": {
    "skipValidation": true,
    "includeRawText": false
  }
}

###

### Master Orchestration - Provider Mode (Medical Terminology)
# For healthcare providers - uses medical terminology
POST {{baseUrl}}/api/v1/medical-report/process
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}",
  "patientContext": {
    "patientId": "P22222",
    "age": 62,
    "gender": "MALE",
    "medicalHistory": [
      "Type 2 Diabetes Mellitus",
      "Essential Hypertension",
      "Chronic Kidney Disease Stage 3"
    ]
  },
  "workflowOptions": {
    "targetAudience": "PROVIDER",
    "includeEducationalContent": false
  }
}

###

### Master Orchestration - ICD-10 Only (No RxNorm)
# Get only diagnosis codes, skip medication codes
POST {{baseUrl}}/api/v1/medical-report/process
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}",
  "patientContext": {
    "patientId": "P33333",
    "age": 28,
    "gender": "Male"
  },
  "workflowOptions": {
    "requestedCodeSystems": ["ICD10"]
  }
}

###

### Master Orchestration - Cardiovascular Risk Focus
# Focus risk assessment on cardiovascular health
POST {{baseUrl}}/api/v1/medical-report/process
Content-Type: application/json

{
  "imageBase64": "{{imageBase64}}",
  "patientContext": {
    "patientId": "P44444",
    "age": 68,
    "gender": "MALE",
    "medicalHistory": [
      "Coronary Artery Disease",
      "Hyperlipidemia"
    ],
    "currentMedications": [
      "Atorvastatin 40mg",
      "Aspirin 81mg"
    ]
  },
  "workflowOptions": {
    "riskAssessmentCategories": ["CARDIOVASCULAR"]
  }
}

###

POST {{baseUrl}}/api/v1/medical-report/process-multi-image
Content-Type: application/json

{
  "images": ["{{imageBase64}}"],
  "patientContext": {
    "patientId": "P12345",
    "age": 45,
    "gender": "MALE",
    "medicalHistory": ["Diabetes Type 2"]
  }
}
