# Medioo site blocks, copied read-only from the box on 2026-10-21 (DR-40, plan task X1); routed per path from W1c.
#
# Source of truth: from W1c on, THIS file. The box's /home/ec2-user/n8n/Caddyfile also holds the n8n ({$DOMAIN}) and
# bddrug (drugdb.eliooo.org) blocks; those are deliberately not copied here, and one reload affects all three tenants.
# The box's medioo/baymax blocks are pasted from this file. Editing this file routes nothing by itself: a path reaches
# medioo-web only once it is routed in the box's Caddyfile (docs/RUNBOOK.md -> Routing a path to medioo-web).
#
# Drift: after every deploy, CI extracts the box's live medioo/baymax blocks (read-only) and compares them with the
# blocks below, comments and blank lines aside (scripts/caddy-drift.sh, tested by scripts/test_caddy_drift.sh). A
# difference fails the deploy job with "box Caddyfile drifted from the repo — fold the box edit in first". Before
# pasting from this file, run the same check by hand; any difference is a box edit to fold in here first, never to
# overwrite.
#
# Editing the box. /home/ec2-user/n8n/Caddyfile is bind-mounted into n8n-caddy-1 as a SINGLE FILE (read-only inside
# the container). Anything that replaces the inode — sed -i, mv of a temp file, rsync, an editor that saves by
# rename — leaves the container reading the old file, and `caddy reload` then quietly reloads the stale config.
#   cd /home/ec2-user/n8n
#   cp Caddyfile Caddyfile.bak-$(date +%Y%m%d-%H%M)
#   cat /path/to/new-Caddyfile > Caddyfile                     # in place only; never sed -i, mv or rsync
#   docker exec n8n-caddy-1 cat /etc/caddy/Caddyfile | diff - Caddyfile          # must print nothing
#   docker exec n8n-caddy-1 caddy validate --config /etc/caddy/Caddyfile        # must say Valid configuration
#   docker exec n8n-caddy-1 caddy reload --config /etc/caddy/Caddyfile
#   curl -sI https://medioo.eliooo.org/ ; curl -sI https://drugdb.eliooo.org/ ; curl -sI https://<n8n host>/
#     -> compare each status code with the one recorded before the edit; any change means restore the backup
#        (cat Caddyfile.bak-... > Caddyfile) and reload.
#
# Headers: deleting `-Server` makes Caddy defer this header block to response-write time, so the values below
# OVERWRITE whatever the upstream sends. Caddy is therefore the owner of HSTS, X-Content-Type-Options and
# Referrer-Policy on every path, Java's or Next's; an upstream that sets a different Referrer-Policy is overruled.
#
# DR-40 A1: Java is the default. A path goes to medioo-web:3000 only once it is listed here and applied on the box.
# Flipping a route back is a one-line edit plus the procedure above, and the routes floor (RUNBOOK -> Rollback).
# The handle blocks are mutually exclusive: the most specific path matcher wins, and the bare `handle` is Java. Routed
# so far: /app/healthz (W1c); the preview path /app/preview and /app/preview/* (less /app/preview/probe, which stays
# Java's), and the assets /_next/static/*, /fonts/* and /brand/* (plan Wave 3, F0); GET and HEAD /app/add, the add
# sheet (F7; POST /app/add, the upload, stays Java's); GET and HEAD /app, /app/ and /app/verify, the sign-in pages
# (F3); GET and HEAD /app/home, the chat page (F5); GET and HEAD /app/family and /app/patients/<uuid>/profile, the
# family tab and a patient's profile (F10; POST to the profile, its save, stays Java's). Every other page, every POST
# to a page and every /app/api/** path is still Java's; each screen's own paths come in its flip PR. scripts/caddy-route-probe.sh runs this file in a
# local Caddy and checks every row of scripts/smoke-https.sh reaches the upstream its class names.
#
# Referrer-Policy stays strict-origin-when-cross-origin, the value production has sent since before the rebuild
# (noted for the PO in the W1c PR): medioo-web's own headers send the same value, and Caddy overwrites it anyway.
#
# Compression: Caddy owns it for medioo-web (PO ruling P3, 2026-10-23). The site-wide `encode zstd gzip` below covers
# every handle, medioo-web's and Java's alike. medioo-web sends every body unencoded (next.config.ts compress: false),
# so this is the one pass that compresses its pages: Next's own streaming gzip had compressed the RSC-heavy document in
# tiny flushes (the 58-value /all page's document 64 KB on the wire, under 18 KB in one stream) and put the page over
# the DR-42 route ceiling. Caddy's encode never touches a body the upstream already encoded, which is why the line was
# here all along and did nothing for medioo-web until P3. It also keeps streaming: a response of unknown length is
# flushed write by write through the encoder (measured locally on 2026-10-23, Caddy 2.11.7). Java is unchanged: its
# pages were already sent unencoded and compressed here (production answered /app/ in zstd before P3, read-only
# check 2026-10-23). The live block was checked read-only the same day: identical to this one, so P3 needs no box edit.
# scripts/smoke-https.sh's /brand/medioo-light.svg row asks for zstd after every deploy; only this line produces it.

medioo.eliooo.org {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /app/healthz {
		reverse_proxy medioo-web:3000
	}

	# F0: the assets every Next page loads (Next's hashed chunks, the two Noto subsets, Mio and the wordmark). Next has
	# no other files under these prefixes and Java has none at all, so a whole prefix is safe to send.
	handle /_next/static/* {
		reverse_proxy medioo-web:3000
	}

	handle /fonts/* {
		reverse_proxy medioo-web:3000
	}

	handle /brand/* {
		reverse_proxy medioo-web:3000
	}

	# F0: the preview path. Both spellings, because `/app/preview/*` alone does not match `/app/preview`, and nothing
	# wider: `/app/preview*` would also take /app/previewx. Every preview page that reads Java reads nothing but `me`
	# until `me` says preview (BAYMAX_WEB_PREVIEW_FAMILIES), so for those pages routing shows the new screens to the
	# allowlisted families only. The DR-42 budget probe reads nothing from Java, so the gate never runs on it: it stays
	# on Java here (the `not path` line), or /app/preview/probe would render to any visitor. The method is unrestricted,
	# per the plan's F0 row: a preview page posts nothing itself (each write is a browser fetch to /app/api/**, which
	# stays on Java); what a POST here answers is measured in the smoke-https.sh header.
	@medioo_preview {
		path /app/preview /app/preview/*
		not path /app/preview/probe /app/preview/probe/*
	}
	handle @medioo_preview {
		reverse_proxy medioo-web:3000
	}

	# F7 (DR-49, PO ruling 2026-10-23): the add sheet (plan W7). GET and HEAD only: POST /app/add is Java's upload,
	# which the old sheet's form and the paper page's retake form post to, and it stays Java's. `path /app/add` is exact,
	# so /app/add/ and /app/addx stay Java's too. Turning the old page back on is deleting this block (RUNBOOK ->
	# Rollback).
	@medioo_add {
		method GET HEAD
		path /app/add
	}
	handle @medioo_add {
		reverse_proxy medioo-web:3000
	}

	# F3: the sign-in pages, GET and HEAD only, exactly these three paths. Every sign-in POST stays Java's (S3:
	# /app/login has no GET and is never routed; POST /app/verify is the no-JS form's target), and so does the no-JS
	# fallback /app/basic* (S1), which `path /app/*` would take. Next's pages post nothing themselves: their writes are
	# browser fetches to /app/api/**, Java's.
	@medioo_signin {
		method GET HEAD
		path /app /app/ /app/verify
	}
	handle @medioo_signin {
		reverse_proxy medioo-web:3000
	}

	# F5 (DR-49, PO ruling 2026-10-23): the chat page (plan W5). GET and HEAD only, per the plan's row: Java routes no
	# POST /app/home, and a POST stays Java's JSON 404. `path /app/home` is exact, so /app/home/ and /app/homex stay
	# Java's too. Turning the old page back on is deleting this block (RUNBOOK -> Rollback).
	@medioo_chat {
		method GET HEAD
		path /app/home
	}
	handle @medioo_chat {
		reverse_proxy medioo-web:3000
	}

	# F10 (DR-49, PO ruling 2026-10-23): the family tab and settings, and a patient's profile (plan W10). GET and HEAD
	# only, per the plan's row: Java routes no POST /app/family, and POST /app/patients/{id}/profile is Java's profile
	# save, which stays Java's. `path /app/family` is exact, so /app/family/ and /app/familyx stay Java's. The profile
	# is a regexp anchored at both ends: one uuid segment (lower-case, as every link writes it) and nothing after
	# `/profile`, so /app/patients/{id} (the patient page, F8's), /app/patients/{id}/profile/ and an id that is not a
	# uuid stay Java's. Turning the old pages back on is deleting these two blocks (RUNBOOK -> Rollback).
	@medioo_family {
		method GET HEAD
		path /app/family
	}
	handle @medioo_family {
		reverse_proxy medioo-web:3000
	}

	@medioo_profile {
		method GET HEAD
		path_regexp ^/app/patients/[0-9a-f-]{36}/profile$
	}
	handle @medioo_profile {
		reverse_proxy medioo-web:3000
	}

	handle {
		reverse_proxy medscribe-ai:8086
	}
}

# Old public name (DR-15, 2026-09-19): every URL already sent to families keeps working via a permanent redirect.
baymax.eliooo.org {
	redir https://medioo.eliooo.org{uri} permanent
}
