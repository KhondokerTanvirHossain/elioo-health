# =============================================================================
# MedScribe AI - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# Do NOT commit the real .env - keep it local/in CI secrets

# Database Configuration
PGHOST=<YOUR_DB_HOST>
PGDATABASE=medscribe
PGUSER=<YOUR_DB_USER>
PGPASSWORD=<YOUR_DB_PASSWORD>

# GCP Credentials Path (on the server)
GCP_CREDENTIALS_PATH=/path/to/your/gcp-credentials.json

# Application Configuration
# Multiple profiles: prod (environment), aws (AWS services), gcp (GCP services)
SPRING_PROFILES_ACTIVE=prod,aws,gcp
SERVER_PORT=8086

# Optional Services
FEATURE_FLAGGING_SERVICE_URL=http://localhost:8087
SPRING_ADMIN_SERVER_URL=http://localhost:8080
MEDSCRIBEAI_SERVICE_URL=http://localhost:8086
ADMIN_SERVER_USERNAME=<YOUR_ADMIN_USER>
ADMIN_SERVER_PASS=<YOUR_ADMIN_PASSWORD>

# Docker Configuration
DOCKER_IMAGE=<YOUR_DOCKERHUB_USER>/medscribe-ai
IMAGE_TAG=latest
CONTAINER_NAME=medscribe-ai-container
