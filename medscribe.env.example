# Runtime configuration for the MedScribe AI container.
# Copy to /home/ec2-user/medscribe.env on the server (chmod 600) and fill in.
# Locally, the equivalent file is .env.local (git-ignored).

SPRING_PROFILES_ACTIVE=prod,aws,gcp

# --- Database (Supabase session pooler) ---
PGHOST=aws-0-ap-south-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=medscribe.iwvtcjzlkiutffzjkvfa
PGPASSWORD=
PGSCHEMA=medscribe

# --- AWS (Textract / Comprehend Medical / Bedrock) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- GCP (Vision OCR / Translate) ---
GCP_PROJECT_ID=medscribe-ai-prod-483312
# Path ON THE HOST; deploy.sh mounts it into the container at /secrets/gcp-credentials.json
GCP_CREDENTIALS_HOST_PATH=/home/ec2-user/gcp-credentials/medscribe-ai-prod-483312-316f94565ddd.json

# --- LLM for clinical insights and chat ---
# groq (default, cheap, for tests) | anthropic (demos) | openai | bedrock
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# --- Optional integrations (leave off unless you run them) ---
SPRING_ADMIN_ENABLED=false
TRACING_ENABLED=false

# ---------------------------------------------------------------------------
# Baymax module (off by default). When on, its routes live under /api/v1/baymax/**
# and its own Flyway migrates schema `baymax` (create it by hand on Supabase first).
# ---------------------------------------------------------------------------
# BAYMAX_ENABLED=true
# Shared secret for /api/v1/baymax/admin/** (header X-Baymax-Admin-Token); admin routes answer 503 while unset
# BAYMAX_ADMIN_TOKEN=
# Object storage for Baymax images: AWS S3, private bucket, EC2 instance role, no static keys (DR-5).
# ENDPOINT / ACCESS_KEY / SECRET_KEY must be genuinely EMPTY in production: docker --env-file keeps values
# verbatim, so even a line of spaces counts as a value and defeats the instance role. See docs/RUNBOOK.md.
# BAYMAX_STORAGE_BUCKET=elioo-baymax-prod
# BAYMAX_STORAGE_REGION=ap-south-1
# BAYMAX_STORAGE_CREDENTIALS=instance-role
# BAYMAX_STORAGE_PATH_STYLE=false
# BAYMAX_STORAGE_SSE=AES256
# BAYMAX_STORAGE_ENDPOINT=
# BAYMAX_STORAGE_ACCESS_KEY=
# BAYMAX_STORAGE_SECRET_KEY=
# Extraction (BMX-2). The cheap vision model is separate from the text model: gpt-oss-120b is text-only.
# BAYMAX_EXTRACT_SEND_IMAGES=true
# BAYMAX_EXTRACT_VISION_MODEL=qwen/qwen3.8-27b
# BAYMAX_EXTRACT_STRONG_MODEL=claude-opus-5
# BAYMAX_EXTRACT_MIN_CONFIDENCE_OVERALL=0.80
# BAYMAX_EXTRACT_MIN_CONFIDENCE_SECTION=0.70
# BAYMAX_EXTRACT_STRONG_MODEL_THRESHOLD=0.85
# BAYMAX_EXTRACT_MAX_PAGES=10

# Sign-in codes (DR-39): sent over WhatsApp, free-form inside the family's own 24 h window, never a template.
# The display number of BAYMAX_WA_PHONE_NUMBER_ID, digits only (8801...), for the sign-in page's wa.me button
# BAYMAX_WA_PUBLIC_NUMBER=
# How recent the family's last WhatsApp message must be for the web to send the code automatically (max 24h)
# BAYMAX_WA_SERVICE_WINDOW=PT23H
# Graph API version: leave unset (shipped default v25.0); set v21.0 only to roll back (v21.0 expires 2027-01-21)
# BAYMAX_WA_GRAPH_VERSION=
# Read ticks for messages Medioo answers: off | read | typing (blank = off)
# BAYMAX_WA_READ_RECEIPTS=off
# true only on a laptop with WhatsApp off (the code is then at DEBUG); comments stay on their own line, see RUNBOOK
# BAYMAX_AUTH_WEB_MINTS_CODE=false

# The /app/api JSON namespace for the Next.js frontend. A POST/PUT/PATCH/DELETE that sends an Origin header must send
# exactly this origin (blank refuses every Origin). On a laptop: http://localhost:8086
# BAYMAX_WEB_PUBLIC_ORIGIN=https://medioo.eliooo.org
# Comma-separated family ids that see the Next.js screens before a route flips (me.preview); blank = nobody
# BAYMAX_WEB_PREVIEW_FAMILIES=

# Free tier caps (defaults shown)
# BAYMAX_FREE_MAX_PATIENTS=1
# BAYMAX_FREE_MAX_DOCS_PER_MONTH=3
