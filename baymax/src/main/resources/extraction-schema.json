{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baymax document extraction (v1)",
  "description": "Everything written on one medical document, transcribed. Nothing is inferred, normalised or translated: a page with no diagnosis line yields an empty diagnosis array, and a truncated line stays truncated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "values",
    "medicines",
    "follow_up",
    "clinical_context",
    "confidence"
  ],
  "properties": {
    "document_type": {
      "type": "string",
      "enum": [
        "lab_report",
        "prescription",
        "discharge_summary",
        "imaging_report",
        "other"
      ]
    },
    "patient_hint": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "document_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date as written on the document; null when the page does not state one. Bangladeshi reports are DAY-FIRST: 04/07/2024 is 4 July 2024, not 4 April. Use day-first unless the page itself proves otherwise (a companion date that only parses one way, or a month spelled out). Never infer a missing year from today."
    },
    "document_date_uncertain": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True when the printed date is genuinely ambiguous and nothing on the page settles it: 07/11/2021 could be 7 November or 11 July, and a page with no second date and no spelled-out month cannot say which. Still fill document_date with the day-first reading, and set this so the server knows it was a convention and not a reading. False or null when the date is unambiguous (a day above 12, a spelled-out month, or a companion date that proves the order)."
    },
    "facility": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "values": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "source_span"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "canonical_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "ref_low": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "ref_high": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "flag": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "low",
              "normal",
              "high",
              "critical",
              null
            ]
          },
          "source_span": {
            "$ref": "#/$defs/source_span"
          },
          "source_region": {
            "$ref": "#/$defs/source_region"
          },
          "specimen": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "blood",
              "urine",
              "stool",
              "other",
              null
            ],
            "description": "Which sample this value was measured in, taken from the section heading the row sits under (\"URINE R/E\", \"BIOCHEMISTRY\", \"COMPLETE BLOOD COUNT\"). Null when the page does not say. Never guess from the test name: the same word can name a blood test and a urine finding, and treating a urine result as a blood result applies the wrong reference range."
          }
        }
      }
    },
    "medicines": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_span"
        ],
        "description": "Every text field verbatim as printed or written: no expansion, no molecule name, no normalisation. '1+0+1' stays '1+0+1'.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dose_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "route": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "frequency_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "timing_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "duration_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "instruction_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "The medicine's WHOLE instruction line, exactly as written, when it cannot be decomposed into the fields above without losing meaning — a multi-phase regimen (\"1+0+0 for 30 days, then 1+0+1 for 2 weeks\") is ONE instruction, not two doses. Set this INSTEAD of guessing a single frequency. Never abbreviate a dosing instruction and never write an ellipsis: the family is shown this text verbatim."
          },
          "source_span": {
            "$ref": "#/$defs/source_span"
          }
        }
      }
    },
    "follow_up": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction",
          "source_span"
        ],
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "A relative instruction is resolved against document_date: '৩ মাস পর আসবেন' on 2026-08-06 becomes 2026-11-06. Null only when the page states no timing at all."
          },
          "source_span": {
            "$ref": "#/$defs/source_span"
          }
        }
      }
    },
    "clinical_context": {
      "type": "object",
      "additionalProperties": false,
      "description": "The narrative of the page, verbatim and in its original language. Bangla stays Bangla.",
      "properties": {
        "chief_complaint": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "source_span"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "duration": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              },
              "source_span": {
                "$ref": "#/$defs/source_span"
              }
            }
          }
        },
        "history": {
          "$ref": "#/$defs/text_lines"
        },
        "examination": {
          "$ref": "#/$defs/text_lines"
        },
        "diagnosis": {
          "$ref": "#/$defs/text_lines",
          "description": "Only a diagnosis written on the page. Never inferred from the medicines, the tests or the symptoms; an absent diagnosis line means an empty array."
        },
        "investigations_advised": {
          "$ref": "#/$defs/text_lines"
        },
        "advice": {
          "$ref": "#/$defs/text_lines",
          "description": "What the doctor told the patient to do. Load-bearing for the Bangla explanation."
        },
        "referral": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "text",
            "source_span"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "source_span": {
              "$ref": "#/$defs/source_span"
            }
          }
        }
      }
    },
    "free_text_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall"
      ],
      "properties": {
        "overall": {
          "$ref": "#/$defs/confidence"
        },
        "values": {
          "$ref": "#/$defs/confidence"
        },
        "medicines": {
          "$ref": "#/$defs/confidence"
        },
        "follow_up": {
          "$ref": "#/$defs/confidence"
        },
        "clinical_context": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "text_lines": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source_span"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "Exactly as written, including a line that stops mid-sentence."
          },
          "source_span": {
            "$ref": "#/$defs/source_span"
          }
        }
      }
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "start",
        "end"
      ],
      "description": "Character offsets into that page's OCR text; the server maps them to a bounding box and stores a crop.",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "left",
        "top",
        "right",
        "bottom"
      ],
      "description": "Where on the page IMAGE you read this item, as a fraction of page width and height (0.0-1.0, top-left origin). Give this for every item, and give it from what you SEE, not from the OCR text: it is the only way to keep a value the OCR text does not contain. Point at the value's own row - tight around the label and the number, never a whole table or a whole page. A region covering more than about a third of the page is discarded.",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}